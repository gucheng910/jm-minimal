{
  "name": "jm-client",
  "version": "1.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tools/e2e/run.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "pc:pack": "vite build && electron-builder --win nsis portable",
    "build:compat": "tsc --noEmit && vite build --mode compat",
    "e2e:compat": "node tools/e2e/compat.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "dev.jmclient.pc",
    "productName": "JM极简版",
    "publish": {
      "provider": "github",
      "owner": "gucheng910",
      "repo": "jm-minimal"
    },
    "directories": {
      "output": "release-pc"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "jm-minimal-setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "jm-minimal-portable-${version}.${ext}"
    },
    "electronLanguages": [
      "zh-CN"
    ],
    "asar": true
  },
  "main": "electron/main.cjs",
  "description": "JM极简版桌面端",
  "author": "JMClient"
}
